-beta.21-22/northspline-0.1.0-beta.21-22.x86_64.rpm"},{"architecture":"x86_64","bytes":16025840,"file":"northspline_0.1.0-beta.21-22_amd64.deb","format":"deb","minimum_system":"glibc 2.35 and Git 2.39","platform":"linux","sha256":"d00da9ee8793d3bfe158e38bac37f4a43c0a7feb63de32fa8abc780dbc44bdf9","url":"https://github.com/devmil/NorthSpline/releases/download/v0.1.0-beta.21-22/northspline_0.1.0-beta.21-22_amd64.deb"}],"build":22,"channel":"beta","notes":["Large repositories respond faster after a pull, fetch, checkout, commit or staging: Northspline now rescans the repository once instead of twice, and History updates about a second earlier in a repository of 63,000 files.","The Logbook no longer fills with failed \"Refresh repository\" entries in large repositories, and an operation that finished is no longer reported as needing attention only because the following refresh took long.","The warning that repository changes \"arrived faster than they could be displayed\" no longer appears after Northspline's own pull or checkout.","A running fetch, pull or push now shows what it is doing and how far it is, for example \"Pull · Updating files 85%\". Downloads of Git LFS files are shown as their own step.","The Logbook lists your operations without the \"Git operation\" entries that every refresh added.","When you pull with uncommitted changes, the Pull dialog now asks you to confirm before you can start, instead of failing after it closed.","While a repository opens, the toolbar shows its branch instead of \"Detached HEAD\".","Closing a repository tab during a running operation can no longer hang.","After a pull, History scrolls to the new HEAD and selects it, so the commits you just pulled are in view."],"tag":"v0.1.0-beta.21-22","version":"0.1.0-beta.21"},"product":"Northspline","releases":[{"assets":[{"architecture":"x86_64","bytes":15563256,"file":"Northspline-0.1.0-beta.21-22-linux-x86_64.AppImage","format":"AppImage","minimum_system":"glibc 2.35 and Git 2.39","plat