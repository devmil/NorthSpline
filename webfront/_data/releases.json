r any of its chips to access commit actions directly, without opening a commit submenu."],"tag":"v0.1.0-beta.27-28","version":"0.1.0-beta.27"},{"assets":[{"architecture":"x86_64","bytes":15755768,"file":"Northspline-0.1.0-beta.26-27-linux-x86_64.AppImage","format":"AppImage","minimum_system":"glibc 2.35 and Git 2.39","platform":"linux","sha256":"a47e704699e4a63db851bf37551eaf2f49b2e294463dca8a3460105e6e57634e","url":"https://github.com/devmil/NorthSpline/releases/download/v0.1.0-beta.26-27/Northspline-0.1.0-beta.26-27-linux-x86_64.AppImage"},{"architecture":"x86_64","bytes":16186561,"file":"Northspline-0.1.0-beta.26-27-linux-x86_64.tar.gz","format":"tar.gz","minimum_system":"glibc 2.35 and Git 2.39","platform":"linux","sha256":"10c2fc04a5044ad0845abf5161ac53090710e7f3fa2f5d2d669be142ccab1b5a","url":"https://github.com/devmil/NorthSpline/releases/download/v0.1.0-beta.26-27/Northspline-0.1.0-beta.26-27-linux-x86_64.tar.gz"},{"architecture":"arm64","bytes":17436324,"file":"Northspline-0.1.0-beta.26-27-macos-arm64.dmg","format":"dmg","minimum_system":"macOS 13.0 and Git 2.39","platform":"macos","sha256":"ed9da8ace9c769bfa99ab1b347a7c1d3fefbaeb58efcf97aa1ad1a60d6640ad7","update_signature":"sOeK8gU2q76GWkb3cF9kmo0EB7O1EY900oHPYd7F3JIq0dnpsDyHhNAPatheqffyVL9FZdwjbKTB6+vDGSy8Dw==","url":"https://github.com/devmil/NorthSpline/releases/download/v0.1.0-beta.26-27/Northspline-0.1.0-beta.26-27-macos-arm64.dmg"},{"architecture":"x86_64","bytes":14614528,"file":"Northspline-0.1.0-beta.26-27-windows-x86_64.msi","format":"msi","minimum_system":"Windows 10 version 1809 and Git 2.39","platform":"windows","sha256":"655cdf27428f0028954df85563f74c1d44da27ffa84427dff1249c214bae84f6","url":"https://github.com/devmil/NorthSpline/releases/download/v0.1.0-beta.26-27/Northspline-0.1.0-beta.26-27-windows-x86_64.msi"},{"architecture":"x86_64","bytes":16230993,"file":"northspline-0.1.0-beta.26-27.x86_64.rpm","format":"rpm","minimum_system":"glibc 2.35 and Git 2.39","platform":"linux","sha256":"4d